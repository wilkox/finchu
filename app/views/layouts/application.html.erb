<!DOCTYPE html>
<html>
<head>
  <title>Finchu | <%= @title %></title>
  <%= stylesheet_link_tag    "application", :media => "all" %>
  <%= javascript_include_tag "application" %>
  <%= csrf_meta_tags %>
</head>
<body>
  <div class="container">
    <%= render 'layouts/navbar' %>

    <% if notice %>
      <div class="alert">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <%= notice %>
      </div>
    <% end %>

    <% if alert %>
      <div class="alert">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <%= alert %>
      </div>
    <% end %>

    <%= yield %>

  </div>
</body>
</html>
